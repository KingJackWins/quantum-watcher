{
  "name": "quantum-watcher",
  "version": "0.9.11",
  "description": "The quantum fuel gauge for your AI coding spend — cost, tokens, agents, and projects",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "quantum-watcher": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle-litellm": "node scripts/bundle-litellm.mjs",
    "build": "node scripts/bundle-litellm.mjs && tsup && node -e \"const fs=require('fs'); fs.copyFileSync('src/cli.ts','dist/cli.js'); fs.chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "kimi",
    "ibm-bob",
    "opencode",
    "pi",
    "codebuff",
    "ai-coding",
    "token-usage",
    "cost-tracking",
    "observability",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "Quantum Memory AI <jack@quantummemory.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KingJackWins/quantum-watcher.git"
  },
  "bugs": {
    "url": "https://github.com/KingJackWins/quantum-watcher/issues"
  },
  "homepage": "https://github.com/KingJackWins/quantum-watcher#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^7.0.0",
    "react": "^19.2.5",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
